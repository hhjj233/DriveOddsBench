# Machine-specific settings of the local Epona tools on a research server (run_dev_local.sh, smoke_dev_local.sh,
# smoke_dev_followup.sh, profile_local.sh, profile_epona.py). Copy this file to local.env next to it and fill in the
# placeholders; local.env is git-ignored (models/epona/.gitignore) and must never be committed. A variable already set in
# the environment wins over the file; WCB_LOCAL_ENV=FILE points the tools at another file (one file may hold the settings
# of several models: each tool reads only its own keys). Format: KEY=VALUE, one per line, no quotes needed, no '#' inside
# a value. The cluster jobs do not read it (cluster/epona passes every path explicitly).

# environment of the Epona tools: holds venv/ (requirements-epona.lock.txt), src-git/ (the Epona checkout at the pinned
# commit), triton-cache/ and inductor-cache/
EPONA_ENV=/path/to/envs/epona
# Epona checkout at the pinned commit (default: $EPONA_ENV/src-git)
EPONA_SRC=/path/to/envs/epona/src-git
# the pinned weights (epona_nuplan+china.pkl, dcae_td_20000.pkl; epona_pins.json)
EPONA_MODELS_DIR=/path/to/checkpoints/epona
# parent of bench-v1/ and epona-v1/ (local inputs and outputs)
WCB_OUTPUTS=/path/to/outputs/wm-calibration
# flock file that serializes GPU jobs on this server, the GPU index the server's rules allow, and that GPU's UUID as the
# adapter sees it (nvidia-smi -L; the guard and the adapter refuse to run on any other GPU)
WCB_GPU_LOCK=/path/to/gpu.lock
WCB_LOCAL_GPU=REPLACE_GPU_INDEX
WCB_LOCAL_GPU_UUID=GPU-REPLACE-WITH-UUID
