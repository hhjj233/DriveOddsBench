# Template only: the kit's tools take explicit command-line arguments and never read a local.env file themselves.
# Copy to local.env (git-ignored) and `source` it in a shell. Do not store credentials here.
DW_SRC=<OFFICIAL_SOURCE_CHECKOUT>          # prepare_source.py --dest
DW_WEIGHTS=<PINNED_WEIGHTS_DIR>             # download_drivingworld_weights.py --dest
DW_PY=<LOCKED_ENV_PYTHON>                   # prepare_env.sh ... NEW_VENV -> NEW_VENV/bin/python
CPU_PY=<RESEARCH_CPU_PYTHON>                # cv2, scipy, pyarrow, av2, ffmpeg (input builder)
WCB_BENCH=<BENCH_V1_DIR>
WCB_SNAPSHOT_DIR=<SHARED_SEED_SNAPSHOT_DIR>
DW_WORK=<PRIVATE_WORK_DIR>
