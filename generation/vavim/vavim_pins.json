  "canvas_map_rules": {
   "nearest": "canvas tick k shows the model frame of tick 5 round(k / 5) (no ties for integer k): each 2 Hz frame covers ticks 5m-2..5m+2; ticks 1-2 show the t0 frame, ticks 3-4 the first generated frame (tick 5); |shown - actual| <= 0.2 s, mean 0 (precedent: ReWorld/DriveLaW nearest native frame)",
   "hold": "canvas tick k shows the model frame of tick 5 floor(k / 5) (latest frame at or before k): ticks 1-4 show the t0 frame; delay 0-0.4 s, mean 0.2 s; causal"
  },
  "prefix": "shared",
  "prefix_rate": "10hz",
  "prefix_rules": {
   "2hz": "canvas ticks whose model tick is <= 0 show the 2 Hz prefix: the VQ round trip (official encoder, official decoder) of the history frames at ticks -20, -15, -10, -5, 0, i.e. exactly the decoded context tokens; mapped like the future",
   "10hz": "canvas ticks -20..0 show the per-frame VQ round trip of all 21 history frames (Orbis 2 precedent); its ticks -20, -15, ..., 0 equal the 2 Hz prefix bit for bit (one encode and one decode of the 21 frames per window); ticks after t0 follow canvas_map"
  },
  "prefix_encode": "the 21 history frames are encoded in ONE tokenizer call and decoded in ONE detokenizer call per window; the context tokens are the rows at ticks -20, -15, -10, -5, 0 of that encode, so prefix frames, context tokens and the t0 frame are shared byte for byte by every clip of the window and its reference",
  "reference_rule": "real future frames at ticks 5, 10, ..., 60 (the window tick frames; DEV, or TEST after stage 2), encoded in one tokenizer call and decoded in one detokenizer call (deterministic VQ round trip, no sampling), assembled with the same shared prefix and the same canvas map as the continuations",
  "sampling": {
   "function": "official MupGPT2._sample_next_token arithmetic: logits[:, -1] / temperature -> softmax -> torch.topk(k, sorted=False) -> renormalise -> torch.multinomial -> gather; the only change is that each batch row draws from its own torch.Generator",
   "temperature": 1.0,
   "top_k": 16385,
