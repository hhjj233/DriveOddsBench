# Template only: the kit's tools take explicit command-line arguments and never read a local.env file themselves.
# Copy to local.env (git-ignored) and `source` it in a shell. Do not store credentials here (no token is needed).
VAVIM_SRC=<OFFICIAL_SOURCE_CHECKOUT>        # prepare_source.py --dest (valeoai/VideoActionModel at the pinned commit)
VAVIM_WEIGHTS=<PINNED_WEIGHTS_DIR>          # download_vavim_weights.py --dest
VAVIM_ENV=<ENV_ROOT>                        # prepare_env.sh UV ENV_ROOT -> ENV_ROOT/venv/bin/python
VAVIM_PY=<LOCKED_ENV_PYTHON>                # ENV_ROOT/venv/bin/python
CPU_PY=<RESEARCH_CPU_PYTHON>                # cv2, numpy, ffmpeg (input builder)
WCB_BENCH=<BENCH_V1_DIR>
WCB_SNAPSHOT_DIR=<SHARED_SEED_SNAPSHOT_DIR>
VAVIM_WORK=<PRIVATE_WORK_DIR>
