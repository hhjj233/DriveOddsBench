# Machine-specific settings of the LTX-2.5 tools on a research server (the local fp8 mechanics smoke, the local weight
# download, the GPU probe). Copy this file to local.env next to it and fill in the placeholders; local.env is git-ignored
# (models/ltx25/.gitignore) and must never be committed. A variable already set in the environment wins over the file;
# WCB_LOCAL_ENV=FILE points the tools at another file. Format: KEY=VALUE, one per line, no quotes needed, no '#' inside a
# value. The cluster jobs do not read it (they pass every path explicitly).

# uv environment of the LTX tools (contains venv/ and src/LTX-2)
LTX25_ENV=/path/to/envs/ltx25
# LTX-2 checkout at the pinned commit (default: $LTX25_ENV/src/LTX-2)
LTX25_SRC=/path/to/envs/ltx25/src/LTX-2
# pinned weights in the Hugging Face layout (download_ltx25_weights.sh writes here)
LTX25_MODELS_DIR=/path/to/checkpoints/ltx25
# parent of bench-v1/, ltx25-inputs-v1/ and the local smoke outputs
WCB_OUTPUTS=/path/to/outputs/wm-calibration
# flock file that serializes GPU jobs on this server, and the GPU index the server's rules allow
WCB_GPU_LOCK=/path/to/gpu.lock
WCB_LOCAL_GPU=REPLACE_GPU_INDEX
# Hugging Face xet chunk cache for the weight download (keep it off a small home disk)
HF_XET_CACHE=/path/to/cache/hf-xet-ltx25
