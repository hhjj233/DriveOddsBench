# Machine-specific settings of the local Wan2.1-VACE-1.3B tools on a research server. Copy this file to local.env next to it
# and fill in the placeholders; local.env is git-ignored (models/wan21_vace13b/.gitignore) and must never be committed.
# A variable already set in the environment wins over the file; WCB_LOCAL_ENV=FILE points the tools at another file.
# Format: KEY=VALUE, one per line, no quotes needed, no '#' inside a value.

# environment of the VACE tools: holds venv/ (requirements-wan21-vace13b.lock.txt), python/ (uv CPython 3.10.12), tools/ (uv)
# and src-git/ (Wan-Video/Wan2.1 at the pinned commit)
VACE_ENV=/path/to/envs/wan21_vace13b
# Wan2.1 checkout at the pinned commit (default: $VACE_ENV/src-git)
VACE_SRC=/path/to/envs/wan21_vace13b/src-git
# python of the lock (run_local_chunks.sh runs the cluster job script with it)
VACE_PY=/path/to/envs/wan21_vace13b/venv/bin/python
# the pinned weights directory (Wan-AI/Wan2.1-VACE-1.3B at the pinned revision; vace_pins.json; download_vace_weights.sh)
VACE_CKPT=/path/to/checkpoints/wan21_vace13b
# this model's local outputs: inputs/, runs/, checks/, prompt-cache/, local-runs/
VACE_OUT=/path/to/outputs/wm-calibration/wan21-vace13b-v1
# the prompt cache (run_vace_bench.py --make-prompt-cache; also shipped in the input package)
VACE_PROMPT_CACHE=/path/to/outputs/wm-calibration/wan21-vace13b-v1/prompt-cache/vace-t5-long.safetensors
# parent of bench-v1/ and wan21-vace13b-v1/
WCB_OUTPUTS=/path/to/outputs/wm-calibration
# Python of the bench instrument (OpenCV 5.0.0: the bench renderer's): input builder, continuation-break measure
WCB_INSTRUMENT_PY=/path/to/envs/cosmos-cpu/bin/python
# directory of the bench scripts (the frozen instrument, scripts/canvas_instrument/, scripts/exploratory/)
WCB_SCRIPTS=/path/to/Cosmos-Drive-Dreams/scripts
# unpacked code snapshot orbis2-code-snapshot-v1 (seed_of)
WCB_SNAPSHOT_DIR=/path/to/snapshot
# the server's GPU runner (NEED_MIB=<MiB> bash WCB_GPU_RUNNER <command>: serialises our GPU jobs and handles the server's
# memory hold), the GPU index it runs on and that GPU's UUID as the adapter sees it (nvidia-smi -L; the adapter refuses any
# other GPU)
WCB_GPU_RUNNER=/path/to/run_on_gpuN.sh
WCB_LOCAL_GPU=REPLACE_GPU_INDEX
WCB_LOCAL_GPU_UUID=GPU-REPLACE-WITH-UUID
