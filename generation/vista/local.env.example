# Machine-specific settings of the local Vista tools on a research server (run_local_chunks.sh, run_dev_smoke.sh, the probes).
# Copy this file to local.env next to it and fill in the placeholders; local.env is git-ignored (models/vista/.gitignore)
# and must never be committed. A variable already set in the environment wins over the file; WCB_LOCAL_ENV=FILE points
# the tools at another file. Format: KEY=VALUE, one per line, no quotes needed, no '#' inside a value.

# environment of the Vista tools: holds venv/ (requirements-vista.lock.txt, cu117: the native-size local tools), venv-cu118/ and src-git/
# (OpenDriveLab/Vista at the pinned commit)
VISTA_ENV=/path/to/envs/vista
# python of the container's lock (requirements-vista-cu118.lock.txt): run_local_chunks.sh runs the cluster job script with it
VISTA_PY=/path/to/envs/vista/venv-cu118/bin/python
# Vista checkout at the pinned commit (default: $VISTA_ENV/src-git)
VISTA_SRC=/path/to/envs/vista/src-git
# the pinned weights (vista.safetensors; vista_pins.json)
VISTA_CKPT=/path/to/checkpoints/vista/vista.safetensors
# parent of bench-v1/ and vista-v1/ (local inputs, specs and outputs)
WCB_OUTPUTS=/path/to/outputs/wm-calibration
# Python of the bench instrument (OpenCV 5.0.0, the AV2 devkit, torchvision with the frozen detector and RAFT weights)
WCB_INSTRUMENT_PY=/path/to/envs/cosmos-cpu/bin/python
# directory of the bench scripts (the frozen instrument and scripts/canvas_instrument/)
WCB_SCRIPTS=/path/to/Cosmos-Drive-Dreams/scripts
# unpacked code snapshot orbis2-code-snapshot-v1 (seed_of)
WCB_SNAPSHOT_DIR=/path/to/snapshot
# flock file that serializes GPU jobs on this server, the GPU index the server's rules allow, and that GPU's UUID as the
# adapter sees it (nvidia-smi -L; the guard and the adapter refuse to run on any other GPU)
WCB_GPU_LOCK=/path/to/gpu.lock
WCB_LOCAL_GPU=REPLACE_GPU_INDEX
WCB_LOCAL_GPU_UUID=GPU-REPLACE-WITH-UUID
# AV2 Sensor root (<root>/<train|val>/<log>/): poses for the T2 actions (build_vista_inputs.py)
WCB_AV2_ROOT=/path/to/datasets/av2_sensor
# the server's GPU runner, if it has one (NEED_MIB=... RUNNER CMD: one GPU job at a time over our users; on a GPU with a
# memory hold it pauses the hold only while CMD runs; on a shared GPU without one it waits for NEED_MIB plus its margin).
# With it the local scripts never touch a hold themselves; without it they take flock on WCB_GPU_LOCK.
# start_scale_check.sh and run_local_chunks.sh require it. Any of these settings can be overridden in the environment.
WCB_GPU_RUNNER=/path/to/tmp/run_on_gpu.sh
